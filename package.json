{
  "name": "@moritzbrantner/viz-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/viz-engine.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mb-rust/geo-viz-core-wasm": "file:../rust-packages/packages/geo-viz-core-wasm"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build": "bun run build:wasm && tsup && cp src/wasm/pkg/viz_engine_wasm_bg.wasm dist/viz_engine_wasm_bg.wasm",
    "build:wasm": "wasm-pack build crates/viz-engine-wasm --target bundler --out-dir ../../src/wasm/pkg",
    "check-types": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "format:check": "prettier --check .",
    "test": "bun run build:wasm && vitest run",
    "test:rust": "cargo test --workspace",
    "test:wasm": "bun run test",
    "verify": "bun run check-types && bun run test && bun run test:rust && bun run build"
  }
}
