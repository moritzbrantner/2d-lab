{
  "name": "viz-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wasm": "bun run build:wasm && vite",
    "build": "vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check": "bun run typecheck && bun run test && bun run test:rust && bun run build"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
