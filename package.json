{
  "name": "2d-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wasm": "bun run build:wasm && vite",
    "build": "vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check": "bun run typecheck && bun run test && bun run test:rust && bun run build",
    "benchmark:smoke": "vitest run src/benchmark-smoke.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
