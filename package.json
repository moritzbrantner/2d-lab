{
  "name": "@moritzbrantner/viz-engine",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/viz-engine.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./core/embedded": {
      "types": "./dist/core-embedded.d.ts",
      "import": "./dist/core-embedded.js"
    },
    "./core/lazy": {
      "types": "./dist/core-lazy.d.ts",
      "import": "./dist/core-lazy.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:wasm && tsup && bun scripts/copy-lazy-wasm-pkg.mjs",
    "build:wasm": "bun ./scripts/build-wasm.mjs",
    "bench": "bun run bench:node && bun run bench:browser",
    "bench:browser": "bun run bench/browser/run-browser.ts --quick",
    "bench:node": "bun run bench/run.ts --runtime bun",
    "bench:gate": "bun run bench/gate.ts",
    "bench:quick": "bun run bench/run.ts --runtime bun --quick",
    "bench:report": "bun run bench/report.ts",
    "bench:table:supported": "bun run bench/run.ts --runtime bun --category table --workload table/query/numeric-filter --workload table/query/boolean-filter --workload table/query/numeric-sort --workload table/query/boolean-sort --workload table/query/combined-numeric",
    "bench:table:summary": "bun bench/table-summary.ts",
    "bundle:size": "bun scripts/report-bundle-size.mjs",
    "check-types": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "package:smoke": "bun run build && bun scripts/package-smoke.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify",
    "test": "bun run build:wasm && vitest run",
    "test:rust": "cargo test --workspace",
    "test:wasm": "bun run test",
    "verify": "bun run check-types && bun run test && bun run test:rust && bun run package:smoke"
  },
  "dependencies": {
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@moritzbrantner/charts": "0.1.1",
    "@moritzbrantner/maps": "0.1.4",
    "@moritzbrantner/ui": "^0.9.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/react": "^16.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.2",
    "d3-array": "^3.2.4",
    "downsample": "^1.4.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.52.0",
    "playwright": "^1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "simple-statistics": "^7.8.9",
    "tailwindcss": "^4.3.0",
    "tinybench": "^4.0.1",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
