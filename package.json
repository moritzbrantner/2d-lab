{
  "name": "@moritzbrantner/viz-engine",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/viz-engine.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:wasm && tsup && cp src/wasm/pkg/viz_engine_wasm_bg.wasm dist/viz_engine_wasm_bg.wasm",
    "build:wasm": "wasm-pack build crates/viz-engine-wasm --target bundler --out-dir ../../src/wasm/pkg",
    "check-types": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify && npm pack --dry-run",
    "test": "bun run build:wasm && vitest run",
    "test:rust": "cargo test --workspace",
    "test:wasm": "bun run test",
    "verify": "bun run check-types && bun run test && bun run test:rust && bun run build"
  },
  "dependencies": {
    "@mb-rust/geo-viz-wasm": "^0.1.0"
  },
  "devDependencies": {
    "@moritzbrantner/ui": "^0.9.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "overrides": {
    "@mb-rust/geo-viz-wasm": "file:../rust-packages/packages/geo-viz-wasm"
  },
  "packageManager": "bun@1.3.14"
}
